{
  "name": "@lixiangzhong/dsh-shell-secrets",
  "version": "0.2.0",
  "description": "DSH bundle: re-inject KEY/PASSWORD/SECRET/TOKEN variables from the launching environment into dsh bash subprocesses under their original names, with a configurable pattern in the Plugins page",
  "license": "MIT",
  "author": "lixiangzhong",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lixiangzhong/dsh-shell-secrets.git"
  },
  "homepage": "https://github.com/lixiangzhong/dsh-shell-secrets#readme",
  "bugs": {
    "url": "https://github.com/lixiangzhong/dsh-shell-secrets/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "dsh-bundle",
    "cordis",
    "bash",
    "secrets",
    "environment-variables",
    "credentials"
  ],
  "type": "module",
  "main": "lib/index.js",
  "icon": "icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./secrets": "./lib/secrets.js",
    "./config": "./lib/config.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "deploy": "node deploy.mjs",
    "check": "node deploy.mjs --check"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-bash-sandbox": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-bash-sandbox": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "engines": {
    "node": ">=22"
  }
}
